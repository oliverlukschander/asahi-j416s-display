From a1fe9bb038bd87b25ddadfe93e60cb08709ecb0b Mon Sep 17 00:00:00 2001
From: Oliver Lukschander <oliver.lukschander@golf.at>
Date: Mon, 21 Sep 2026 16:47:47 +0200
Subject: [PATCH] drm/apple: USB4 DPIN CORE=1 ATC=4 without PHY steal

0075 analog pulse on ACTIVATE bounced and consumed +0x18. Stop
pulsing analog. Bind CORE=1 with ATC=4 (target 0x9041) so firmware
uses the lpdptxphy DPTX object as the USB4 dpin0 engine. Do not
phy_set_mode or write core+0x10. usb4_atc=0 rolls back to 0x9001.

Signed-off-by: Oliver Lukschander <oliver.lukschander@golf.at>
---
 drivers/gpu/drm/apple/dcp.c    | 25 +++++++++++++------------
 drivers/gpu/drm/apple/dptxep.c | 18 ------------------
 2 files changed, 13 insertions(+), 30 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 8ed9a91..9133d06 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1438,13 +1438,14 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
 		dev_info(dcp->dev,
 			 "USB4: skip DPTX connect (echo 1 > usb4_dptx_train after lid close)\n");
 		/*
-		 * Analog PHY is up. Bind DPIN CORE=1 (0x9001). 0073
-		 * GET_SUPPORTS_HPD=1 stopped 22/24. 0074 set_hpd after
-		 * request_display timed out (-110). set_hpd before the
-		 * nub; analog start is on ACTIVATE. No lpdptxphy steal.
+		 * Analog PHY is up. 0075 analog pulse on ACTIVATE bounced
+		 * and consumed +0x18. Bind CORE=1 with ATC=4 (lpdptxphy
+		 * firmware object, target 0x9041) without core+0x10.
+		 * usb4_atc=0 rolls back to 0x9001. No analog MMIO.
 		 */
 		if (dcp->dptxport[port].enabled && dcp->dptxport[port].service) {
 			u8 cores[2];
+			u8 atc = (usb4_atc >= 0) ? usb4_atc : 4;
 			int n = 0, i, v = -EINVAL, c = -EINVAL, h = -EINVAL,
 			    r = -EINVAL;
 
@@ -1455,19 +1456,19 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
 				u8 core = cores[i];
 
 				v = dptxport_validate_connection(
-					dcp->dptxport[port].service, core, 0,
+					dcp->dptxport[port].service, core, atc,
 					dcp->dptx_die);
 				dev_info(dcp->dev,
-					 "USB4: analog DPIN validate core=%u atc=0: %d\n",
-					 core, v);
+					 "USB4: analog DPIN validate core=%u atc=%u: %d\n",
+					 core, atc, v);
 				if (v)
 					continue;
 				c = dptxport_connect(dcp->dptxport[port].service,
-						     core, 0, dcp->dptx_die,
+						     core, atc, dcp->dptx_die,
 						     true);
 				dev_info(dcp->dev,
-					 "USB4: analog DPIN connect core=%u atc=0 HPD: %d\n",
-					 core, c);
+					 "USB4: analog DPIN connect core=%u atc=%u HPD: %d\n",
+					 core, atc, c);
 				if (!c)
 					h = dptxport_set_hpd(
 						dcp->dptxport[port].service,
@@ -1478,8 +1479,8 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
 					r = dptxport_request_display(
 						dcp->dptxport[port].service);
 					dev_info(dcp->dev,
-						 "USB4: analog DPIN request_display core=%u: %d\n",
-						 core, r);
+						 "USB4: analog DPIN request_display core=%u atc=%u: %d\n",
+						 core, atc, r);
 				}
 				break;
 			}
diff --git a/drivers/gpu/drm/apple/dptxep.c b/drivers/gpu/drm/apple/dptxep.c
index a0dd9d6..88ea906 100644
--- a/drivers/gpu/drm/apple/dptxep.c
+++ b/drivers/gpu/drm/apple/dptxep.c
@@ -555,24 +555,6 @@ dptxport_call_activate(struct apple_epic_service *service,
 	    (!dcp->phy_managed_by_typec || dcp_is_usb4_output(dcp)))
 		phy_set_mode_ext(dptx->atcphy, PHY_MODE_DP, dcp->index);
 
-	/*
-	 * Analog DPIN: ACTIVATE with no atcphy. 0073 left firmware waiting
-	 * after HPD=1 (no 22/24, analog 0x1017). Pulse ACIO analog now that
-	 * the nub is powered. Do not phy_set_mode lpdptxphy.
-	 */
-	if (dcp_is_usb4_output(dcp) && !dptx->atcphy) {
-		void (*analog)(void);
-
-		analog = __symbol_get("apple_usb4_dpin_on_activate");
-		if (analog) {
-			dev_info(dcp->dev, "USB4: ACTIVATE pulse ACIO analog\n");
-			analog();
-			__symbol_put("apple_usb4_dpin_on_activate");
-		} else {
-			dev_info(dcp->dev, "USB4: ACTIVATE no analog helper\n");
-		}
-	}
-
 	memcpy(reply, data, min(reply_size, data_size));
 	if (reply_size >= 4)
 		memset(reply, 0, 4);
-- 
2.55.0

