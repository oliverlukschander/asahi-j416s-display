From 32ecfcef0fbdd927450fafe98bb082b013e4be23 Mon Sep 17 00:00:00 2001
From: Oliver Lukschander <oliver.lukschander@golf.at>
Date: Thu, 24 Sep 2026 13:37:22 +0200
Subject: [PATCH] drm: apple: log possible_crtcs computation and
 dcp_crtc_atomic_check reach

0140 (drop usb4_native_dpin/usb4_protocol_probe, believed to be excluding
dcpext0's CRTC bit from the right port's possible_crtcs) was installed
and tested: it did NOT change the symptom. A live replug produced the
exact same Aquamarine cascade (800x600/720x576/720x480/640x480, each
ATOMIC_TEST_ONLY commit failing with EINVAL) byte-for-byte identical to
before 0140, and apple_plane_atomic_check() still never fires for the
tunnel connector's plane. Either the possible_crtcs theory was wrong, or
something else besides the exclusion 0140 removed is also excluding
dcpext0's CRTC bit.

Add two more diagnostics to settle it directly instead of guessing
again: apple_probe_typec_ports() now logs each candidate DCP's
dcp-index/native_route/has_candidate/crtc_mask contribution and the
final computed possible_crtcs mask for the port, at probe time.
dcp_crtc_atomic_check() now logs every reach of that per-CRTC hook
(crtc id, mode, active, enable), to show whether the generic DRM core
even gets as far as a per-CRTC driver hook for dcpext0's CRTC during a
failed commit, or rejects the whole transaction earlier at the
encoder/CRTC pairing stage before any driver code for that CRTC runs.

Built and verified (make in src/appledrm/, vermagic
7.1.12-2.5-1-ARCH, no new warnings; only apple_drv.o/dcp.o recompiled).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 drivers/gpu/drm/apple/apple_drv.c | 26 +++++++++++++++++++++-----
 drivers/gpu/drm/apple/dcp.c       | 15 +++++++++++++++
 2 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index 44767b1fe..f2586e7d3 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -467,18 +467,34 @@ static int apple_probe_typec_ports(struct drm_device *drm,
 
 		for (i = 0; i < num_dcp; i++) {
 			struct apple_dcp *candidate = platform_get_drvdata(dcp[i]);
+			bool native_route = dcp_usb4_native_route(idx);
+			bool has_candidate = dcp_typec_port_has_candidate(idx, dcp[i]);
 
 			/*
-			 * Userspace caches possible_crtcs before the hub is attached.
-			 * The native test owns dcpext1; advertise only that CRTC
-			 * from registration, not a wider mask narrowed at hotplug.
+			 * Diagnostic (candidate 0141, see notes/2026-09-24-0141-*.md):
+			 * 0140 dropped usb4_native_dpin/usb4_protocol_probe so
+			 * native_route should read false here now, but the tunnel
+			 * connector's plane atomic_check still never fires and
+			 * every Aquamarine commit still fails ATOMIC_TEST_ONLY
+			 * with EINVAL, unchanged. Log the actual computed
+			 * contribution per candidate to see directly whether this
+			 * exclusion is (still) why dcpext0's CRTC bit is missing
+			 * from this port's possible_crtcs, or whether it never was.
 			 */
-			if (dcp_usb4_native_route(idx) && candidate->index != 2)
+			drm_info(drm,
+				 "typec port %u candidate dcp-index=%u native_route=%d has_candidate=%d crtc_mask=0x%x\n",
+				 idx, candidate->index, native_route, has_candidate,
+				 crtc_mask[i]);
+
+			if (native_route && candidate->index != 2)
 				continue;
-			if (dcp_typec_port_has_candidate(idx, dcp[i]))
+			if (has_candidate)
 				mask |= crtc_mask[i];
 		}
 
+		drm_info(drm, "typec port %u final possible_crtcs mask=0x%x\n",
+			 idx, mask);
+
 		if (!mask) {
 			drm_warn(drm, "Type-C port %u has no display pipeline\n",
 				 idx);
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 071c301e4..2497200eb 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1358,6 +1358,21 @@ int dcp_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_state *state)
 
 	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
 
+	/*
+	 * Diagnostic (candidate 0141): the tunnel connector's plane
+	 * atomic_check never fires and every Aquamarine commit fails
+	 * ATOMIC_TEST_ONLY with EINVAL, unchanged before and after removing
+	 * the possible_crtcs exclusion (0140). Log every reach of this
+	 * per-CRTC hook to see whether the generic core even gets this far
+	 * for dcpext0's CRTC during a failed attempt, or rejects the
+	 * transaction earlier (encoder/CRTC pairing) before any driver hook
+	 * for this CRTC runs at all.
+	 */
+	dev_info(dcp->dev,
+		 "dcp_crtc_atomic_check: crtc=%d mode=%dx%d active=%d enable=%d\n",
+		 crtc->base.id, crtc_state->mode.hdisplay, crtc_state->mode.vdisplay,
+		 crtc_state->active, crtc_state->enable);
+
 	needs_modeset = drm_atomic_crtc_needs_modeset(crtc_state) || !dcp->valid_mode;
 	if (!needs_modeset && (!dcp->connector || !dcp->connector->connected)) {
 		/*
-- 
2.55.0

