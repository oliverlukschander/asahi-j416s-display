From 4062132f7f56499f3c9bbf9faabacc4db1e2c2bd Mon Sep 17 00:00:00 2001
From: Oliver Lukschander <oliver.lukschander@golf.at>
Date: Mon, 21 Sep 2026 18:35:20 +0200
Subject: [PATCH] drm/apple: start USB4 DCPDPDevice with ATC AUX

A second set_hpd after the 0x9001 nub is powered is what makes
firmware init DCPDPDevice and attach it to DPTXController. That
start timed out with no PHY. Enable USB-C ATC DP AUX without
switching SS lanes, then set_hpd.

Signed-off-by: Oliver Lukschander <oliver.lukschander@golf.at>
---
 drivers/gpu/drm/apple/dcp.c | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 9740e53..c774078 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1493,7 +1493,7 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
 					    dcp->active_typec_route->usb4_xbar) {
 						struct apple_dcp_typec_route *route =
 							dcp->active_typec_route;
-						int m;
+						int m, aux, h2;
 
 						mux_control_deselect(route->usb4_xbar);
 						m = mux_control_select(route->usb4_xbar,
@@ -1501,6 +1501,31 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
 						dev_info(dcp->dev,
 							 "USB4: reselect dpin after nub: %d\n",
 							 m);
+						/*
+						 * A second set_hpd, once the nub
+						 * is powered, is what makes
+						 * firmware init DCPDPDevice and
+						 * attach it to DPTXController.
+						 * 0074 did that with no AUX and
+						 * the device start timed out
+						 * (22/24). Enable USB-C ATC AUX
+						 * (no lane switch) first so the
+						 * device has a PHY to start.
+						 */
+						if (dcp->phy) {
+							dcp->dptxport[bind].atcphy =
+								dcp->phy;
+							aux = phy_set_mode_ext(
+								dcp->phy, PHY_MODE_DP,
+								dcp->index);
+							dev_info(dcp->dev,
+								 "USB4: ATC AUX before DCPDPDevice: %d\n",
+								 aux);
+						}
+						h2 = dptxport_set_hpd(svc, true);
+						dev_info(dcp->dev,
+							 "USB4: set_hpd after nub (DCPDPDevice): %d\n",
+							 h2);
 					}
 				}
 				break;
-- 
