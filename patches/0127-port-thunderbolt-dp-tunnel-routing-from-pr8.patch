+		.base = regs,
+		.deadline = jiffies + msecs_to_jiffies(1000),
+	};
+	struct apple_dpin_io io = {
+		.read = apple_dpin_read,
+		.write = apple_dpin_write,
+		.wait = apple_dpin_wait,
+		.ctx = &poll,
