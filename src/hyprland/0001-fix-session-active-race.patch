@@ -2653,7 +2653,28 @@ void CMonitorState::ensureBufferPresent() {
     m_owner->m_output->swapchain->rollback(); // restore the counter, don't advance the swapchain
 }
 
+// Many call sites across this file commit or test monitor state directly
+// (CMonitor::onConnect(), ::applyMonitorRule(), ::onDisconnect(), etc.) and
+// none of them individually check whether the session is active first --
+// only the frame-scheduler's own onFrame() path does, via canRender(). A
+// hotplug reconnect (a real display coming back after a Thunderbolt/USB4
+// tunnel teardown, or a fresh compositor session's own startup racing a
+// monitor appearing) can run any of these while the session is still
+// transitioning, and the resulting failed commit/test is not itself the
+// problem -- what's dangerous is relying on every current and future
+// caller to remember to gate itself, when a single missed call site is
+// enough to reach a real hardware commit attempt during exactly the
+// window commitState() and restoreAfterVT() (in Aquamarine) already
+// treat as unsafe. Gating here, at the one place every commit/test
+// ultimately funnels through, removes that risk categorically.
+static bool sessionIsActive() {
+    return !((g_pCompositor->m_aqBackend->hasSession() && !g_pCompositor->m_aqBackend->session->active) || !g_pCompositor->m_sessionActive);
+}
+
 bool CMonitorState::commit() {
+    if (!sessionIsActive())
+        return false;
+
     if (!updateSwapchain())
         return false;
 
@@ -2666,6 +2687,9 @@ bool CMonitorState::commit() {
 }
 
 bool CMonitorState::test() {
+    if (!sessionIsActive())
+        return false;
+
     if (!updateSwapchain())
         return false;
 
